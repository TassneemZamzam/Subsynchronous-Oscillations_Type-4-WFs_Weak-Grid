      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Turbine radius" name="Rad_turb" group="General" unit="m" min="1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[63 [m]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Nacelle radius" name="R_nacelle" group="General" unit="m" min="1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.6 [m]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Active power" name="Pbase" group="" unit="MW" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[5.0 [MW]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Air density kg/m3" name="rho" group="General" unit="" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.225]]></value>
