      </svg>
      <script>
        <segment name="Fortran" id="230607732" classid="CoreSegment"><![CDATA[      $Ppu = (1.0e-6/$Pbase) * $rho * 0.5 * (pi_*($Rad_turb*$Rad_turb)) * $Cp * $Vwind*$Vwind*$Vwind]]></segment>
