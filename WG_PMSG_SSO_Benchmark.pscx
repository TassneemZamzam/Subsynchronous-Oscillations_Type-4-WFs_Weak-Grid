    <Definition classid="UserCmpDefn" name="abcdq60_2_1_1_1_1" url="" view="false" instances="0" date="0" crc="88681599" id="349097453" group="CSMF">
      <paramlist>
        <param name="Description" value="abc dq0 transformation" />
      </paramlist>
      <form name="ABC - DQ0 Transformation" w="280" h="420" splitter="65">
        <category name="Configuration" visible="true">
          <cond />
          <parameter type="Choice" name="IDir" desc="Direction of transformation" group="" helpmode="Overwrite">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = DQ0 to ABC]]></choice>
            <choice><![CDATA[1 = ABC to DQ0]]></choice>
            <cond />
            <help><![CDATA[This component can transform values in either direction. Select which direction you would like to use.]]></help>
          </parameter>
          <parameter type="Real" name="Theta" desc="Transformation angle" content_type="Variable" min="" max="" unit="rad" group="" helpmode="Overwrite" intent="Input" dim="1">
            <value><![CDATA[0.0]]></value>
            <cond />
            <help><![CDATA[The angle of transformation for the equations.]]></help>
          </parameter>
          <parameter desc="DQ sequence" name="dqorder" group="" type="Choice" helpmode="Overwrite">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[Select the preferred sequence of D and Q: Q leading or lagging D]]></help>
            <choice><![CDATA[-1 = Q - axis leading]]></choice>
            <choice><![CDATA[1 = Q - axis lagging]]></choice>
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="2">
        <port model="Transfer" name="A" x="-36" y="-18" dim="1" mode="Input" type="Real" internal="false"><![CDATA[IDir==1]]></port>
