    <Definition classid="UserCmpDefn" name="hardlimit_66_2_1_1_1_1" url="" view="false" instances="9" date="0" crc="90081601" id="1283569626" group="CSMF">
      <paramlist>
        <param name="Description" value="Hard Limiter" />
      </paramlist>
      <form name="Hard Limiter" w="280" h="420" splitter="70">
        <category name="Configuration" visible="true">
          <cond />
          <parameter type="Real" name="UL" desc="Upper limit" content_type="Variable" min="" max="" unit="" group="Internal Limits" helpmode="Append" intent="Input">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[limit==0]]></cond>
            <help><![CDATA[Upper limit]]></help>
          </parameter>
          <parameter type="Real" name="LL" desc="Lower limit" content_type="Variable" min="" max="" unit="" group="Internal Limits" helpmode="Append" intent="Input">
            <value><![CDATA[-1]]></value>
            <cond><![CDATA[limit==0]]></cond>
            <help><![CDATA[Lower limit]]></help>
          </parameter>
          <parameter type="Text" name="COM" desc="Fortran Comment" group="General" helpmode="Overwrite">
            <value><![CDATA[Hard_Limit]]></value>
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Dimension" name="Dim" group="General" unit="" min="1" max="" content_type="Literal" type="Integer" helpmode="Append" intent="Input">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[Dimension of input/output ports]]></help>
          </parameter>
          <parameter desc="Limits" name="Limit" group="General" type="Choice" helpmode="Overwrite">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Select to enter limits as external connection or internal parameter]]></help>
            <choice><![CDATA[0 = internal]]></choice>
            <choice><![CDATA[1 = external]]></choice>
          </parameter>
        </category>
      </form>
