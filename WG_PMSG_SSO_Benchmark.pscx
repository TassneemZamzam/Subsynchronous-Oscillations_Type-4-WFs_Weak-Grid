      <script>
        <segment name="Fortran" id="985525967" classid="CoreSegment"><![CDATA[#STORAGE RTCF:3
#BEGIN
      RTCF(NRTCF)   = 0.5*ABS($deadband)
      RTCF(NRTCF+1) = ABS($Gain)
      RTCF(NRTCF+2) = ABS($offset)
      NRTCF = NRTCF + 3
#ENDBEGIN
      $Out = 0.0
#IF Dim == 1
      IF ($In .GT. RTCF(NRTCF)) THEN
        $Out = RTCF(NRTCF+1)*($In - RTCF(NRTCF)) +  RTCF(NRTCF+2)
      ELSEIF ($In .LT. -RTCF(NRTCF)) THEN
        $Out = RTCF(NRTCF+1)*($In + RTCF(NRTCF)) -  RTCF(NRTCF+2)
      ENDIF
#ELSEIF Dim > 1
      WHERE ($In .GT. RTCF(NRTCF)) $Out = RTCF(NRTCF+1)*($In - RTCF(NRTCF)) +  RTCF(NRTCF+2)
      WHERE ($In .LT. -RTCF(NRTCF)) $Out = RTCF(NRTCF+1)*($In + RTCF(NRTCF)) -  RTCF(NRTCF+2)
#ENDIF
      NRTCF = NRTCF + 3]]></segment>
        <segment name="FlyBy" id="444763209" classid="CoreSegment"><![CDATA[Deadband with configurable offset and gain
:In
Input
:Out
Output]]></segment>
      </script>
