      <script>
        <segment name="Fortran" id="88468086" classid="CoreSegment"><![CDATA[#FUNCTION REAL LIMIT Hard Limiter
#STORAGE LOGICAL:1
!  $COM
#IF Dim==1
 #IF limit==0
      IF ($LL .LE. $UL) THEN
        $O = LIMIT($LL, $UL, $I)
 #ELSE
      IF ($LLE .LE. $ULE) THEN
        $O = LIMIT($LLE, $ULE, $I)
 #ENDIF
#ELSEIF Dim>1
 #LOCAL INTEGER IVD1_1
 #IF limit==0
      IF ($LL .LE. $UL) THEN
        DO IVD1_1 = 1,$Dim
          $O(IVD1_1) = LIMIT($LL, $UL, $I(IVD1_1))
        ENDDO
 #ELSE
      IF ($LLE .LE. $ULE) THEN
        DO IVD1_1 = 1,$Dim
          $O(IVD1_1) = LIMIT($LLE, $ULE, $I(IVD1_1))
        ENDDO
 #ENDIF
#ENDIF
      ELSE
        $O = $I
        IF (STORL(NSTORL) .EQV. .FALSE.) THEN
          CALL EMTDC_WARN(ICALL_NO,$#Component,1,"Lower limit is more than the upper limit, limits not enforced.")
          STORL(NSTORL) = .TRUE.
        ENDIF
      ENDIF
      NSTORL = NSTORL + 1
!]]></segment>
        <segment name="FlyBy" id="2054265551" classid="CoreSegment"><![CDATA[:I
Input
:O
Output
:ULE
Upper limit
:LLE
Lower limit]]></segment>
      </script>
