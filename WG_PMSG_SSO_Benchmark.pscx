      </svg>
      <script>
        <segment name="Fortran" id="605427653" classid="CoreSegment"><![CDATA[#SUBROUTINE TRDQO DQ0 transformation
#CASE IDir {!DQ0 to ABC~}{!ABC to DQ0~}
~ transformation
#IF IDir==1
      CALL TRDQO($A,$B,$C,$D,$Q,$O,$Theta,$IDir2)
 #IF dqorder==-1
      $Q = -$Q
 #ENDIF
#ELSE
 #IF dqorder==-1
  #LOCAL REAL RVD1_1
      RVD1_1 = -$Q
      CALL TRDQO($A,$B,$C,$D,RVD1_1,$O,$Theta,$IDir2)
 #ELSE
      CALL TRDQO($A,$B,$C,$D,$Q,$O,$Theta,$IDir2)
 #ENDIF
#ENDIF]]></segment>
        <segment name="Computations" id="448217343" classid="CoreSegment"><![CDATA[INTEGER IDir2 = 2*IDir-1]]></segment>
      </script>
