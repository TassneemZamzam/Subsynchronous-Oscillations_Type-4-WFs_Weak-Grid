        <line x1="-36" y1="36" x2="-36" y2="21" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="Vw" />
        <line x1="-38" y1="0" x2="-18" y2="0" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="-30" y="12" stroke="black" font-size="Small" text-anchor="Middle"><![CDATA[2]]></text>
