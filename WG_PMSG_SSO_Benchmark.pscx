    <Definition classid="UserCmpDefn" name="WindTurbine_Mechanical" group="" url="" version="" build="" crc="14635683" instances="0" key="" view="false" date="1792244627" id="1449127903">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="400" h="500" splitter="70">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Turbine radius" name="Rad_turb" group="1. Turbine parameters" unit="m" min="1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[63 [m]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cut-in wind speed" name="vWcutin" group="3. Pitch angle control" unit="m/s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[3.0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cut-out wind speed" name="vWcutout" group="3. Pitch angle control" unit="m/s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[25.0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Turbine RPM at machine nom speed" name="VRot_nom" group="1. Turbine parameters" unit="rpm" min="1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[12 [rpm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Minimum pitch angle" name="Pitch_min" group="1. Turbine parameters" unit="deg" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0 [deg]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Maximum pitch angle" name="Pitch_max" group="1. Turbine parameters" unit="deg" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[30 [deg]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Reference machine speed set point" name="Wref_sp" group="2. Machine parameters" unit="pu" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.2 [pu]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Active power" name="Pbase" group="2. Machine parameters" unit="MW" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[5.0 [MW]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Regulator gain" name="Kp_Ptch" group="3. Pitch angle control" unit="pu" min="0.0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Kp_Ptch]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Regulator time constant" name="Ti_Ptch" group="3. Pitch angle control" unit="pu" min="0.0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Ti_Ptch]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
