    <Definition classid="UserCmpDefn" name="Type4_WTG" group="" url="" version="" build="" crc="124615601" instances="0" key="" view="false" date="1792244626" id="554862552">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="450" h="458" splitter="75" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Enable/Disable the wind turbine" name="Dblk" group="1- General" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Dblk]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Transformer HV Rating (PCC)" name="Vtrf_HV" group="5- High Voltage Rating" unit="kV" min="1E-06" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Vtrf_HV]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Total number of wind turbine generator" name="No_WTG" group="2-Turbine" unit="" min="1E-308" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated powerof one unit[MVA]" name="Sbase" group="2-Turbine" unit="MVA" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[2.0 [MVA]]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="PM Rated Voltage" name="Vrated_PM" group="4- PM Machine" unit="kV" min="1E-06" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Vrated_PM]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Input wind speed" name="Vwind" group="3- Wind" unit="m/s" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[11.0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Cut-in wind speed" name="vWcutin" group="3- Wind" unit="m/s" min="-1E+308" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[3.0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Cut-out wind speed" name="vWcutout" group="3- Wind" unit="m/s" min="-1E+308" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[25.0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Turbine RPM at machine nom speed [rpm]" name="VRot_nom" group="2-Turbine" unit="" min="0" max="10000" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[12]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Nominal system frequency" name="freq" group="1- General" unit="Hz" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[50 [Hz]]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Machine base frequency" name="freq_PM" group="4- PM Machine" unit="Hz" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[30 [Hz]]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
      </form>
