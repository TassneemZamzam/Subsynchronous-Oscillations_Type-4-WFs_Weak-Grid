      </svg>
      <script>
        <segment name="Fortran" id="140823249" classid="CoreSegment"><![CDATA[!
      IF (ABS($IN2) .LT. 1.0E-10) THEN
         IF ($IN2 .LT. 0.0)  THEN
            $OUT = -1.0E10 * $IN1
         ELSE
            $OUT =  1.0E10 * $IN1
         ENDIF
      ELSE
         $OUT = $IN1 / $IN2
      ENDIF
!
]]></segment>
        <segment name="FlyBy" id="1323781725" classid="CoreSegment"><![CDATA[
:IN1
Numerator (variable, type real)
:IN2
Denominator (variable, type real)
:OUT
Output signal (variable, type real)]]></segment>
      </script>
