        <text x="-17" y="33" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[Vwind]]></text>
        <line x1="-36" y1="20" x2="-31" y2="25" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="Cp" />
