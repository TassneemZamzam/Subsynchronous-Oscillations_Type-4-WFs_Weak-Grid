      <script>
        <segment name="Fortran" id="1520709109" classid="CoreSegment"><![CDATA[
#LOCAL INTEGER IFR
      IF ((TIME.GE.$RT).AND.(TIME.LT.$RT+DELT))THEN
      OPEN(UNIT=77,FILE="$FN1.txt",STATUS="UNKNOWN")
      DO IFR = 1,$Dim
!        WRITE(77,'(10(1X,E14.7))')$AL(I),$BL(I)
        WRITE(77,*)$AL(IFR),',',$BL(IFR)
        
      ENDDO
      CLOSE(UNIT=77)
      ENDIF
]]></segment>
        <segment name="Branch" id="238412427" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1489547991" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
